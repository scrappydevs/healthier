NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend Supabase (public keys for browser)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

DEBUG=true
APP_NAME="Healthier API"
